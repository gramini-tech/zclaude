{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": ["node"],
    "strictNullChecks": false,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": false,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "lib": ["es2023"],
    "maxNodeModuleJsDepth": 0
  },
  "include": ["bin/**/*.js", "src/**/*.js", "scripts/**/*.js", "extension/src/**/*.js"],
  "exclude": ["node_modules"]
}
